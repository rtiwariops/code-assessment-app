# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Storage
S3_BUCKET_NAME=maximizehire-uploads-dev

# Google Analytics 4 (public Measurement ID; falls back to a default in layout.tsx if unset)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# OpenAI — enables the AI-generated/plagiarism check on submit (fail-open if unset)
OPENAI_API_KEY=sk-...
